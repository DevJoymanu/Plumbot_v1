#!/usr/bin/env bash
# Plumbot commit gate — runs the deterministic regression suite (TEST 0) before
# every commit and blocks the commit if anything fails. Fast (no network: a
# mocked DeepSeek is used) and meaningful (no flaky live-LLM tests).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip in an emergency:    git commit --no-verify   (avoid; fix the test instead)
#
# Every change to intent classification, the pricing gates, or flow routing must
# add/extend an API-free case in tests/test_bot_responses.py TEST 0 — this hook
# is what makes that rule mechanical instead of hopeful.

set -u

# Resolve repo root regardless of where git invokes the hook from.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT" || exit 1

# Pick an interpreter: project venv first, then PATH, then the Windows launcher.
#
# Every candidate is VERIFIED to actually run before it is used. The old chain
# ended in a bare unverified "python3", so on a machine without that name the
# hook ran a missing binary, got a non-zero status, and reported "Commit
# blocked: the deterministic regression suite (TEST 0) failed" — sending people
# to hunt a test failure that did not exist. That bites specifically when git is
# invoked by a GUI (VS Code's Source Control panel), which on Windows often has
# a narrower PATH than the terminal where the same commit works fine.
PY_CMD=()
_try_py() {
    if "$@" -c "import sys" >/dev/null 2>&1; then
        PY_CMD=("$@")
        return 0
    fi
    return 1
}

# A per-clone escape hatch, checked first. Set it when your IDE's PATH differs
# from your terminal's and you don't keep a .venv here:
#   git config plumbot.python "C:/Program Files/Python39/python.exe"
# It lives in .git/config, so it is per-machine and never committed.
_CONFIGURED_PY="$(git config --get plumbot.python 2>/dev/null || true)"
if [ -n "$_CONFIGURED_PY" ]; then
    _try_py "$_CONFIGURED_PY" || {
        echo "⚠️  plumbot.python is set to '$_CONFIGURED_PY' but it does not run —"
        echo "    falling back to auto-detection."
    }
fi

[ "${#PY_CMD[@]}" -gt 0 ] ||
_try_py "$ROOT/.venv/Scripts/python.exe" ||   # Windows venv
_try_py "$ROOT/.venv/bin/python" ||           # POSIX venv
_try_py python ||
_try_py python3 ||
_try_py py -3 ||
_try_py py ||
true

if [ "${#PY_CMD[@]}" -eq 0 ]; then
    echo ""
    echo "❌ Commit blocked: no working Python interpreter was found."
    echo "   This is NOT a test failure — the gate could not run at all."
    echo "   Tried: .venv/Scripts/python.exe, .venv/bin/python, python, python3, py -3, py"
    echo ""
    echo "   If this commit came from an IDE (e.g. VS Code's Source Control panel),"
    echo "   its PATH is probably narrower than your terminal's. Either commit from"
    echo "   the terminal, or create a project venv at .venv so the hook finds it"
    echo "   without relying on PATH at all."
    exit 1
fi

echo "🔒 Using interpreter: ${PY_CMD[*]}"

echo "🔒 Plumbot commit gate — running deterministic regression suite…"
PYTHONIOENCODING=utf-8 PLUMBOT_GATE=1 "${PY_CMD[@]}" tests/test_bot_responses.py
status=$?

if [ "$status" -ne 0 ]; then
    echo ""
    echo "❌ Commit blocked: the deterministic regression suite (TEST 0) failed."
    echo "   Fix the failure, or if you changed gating/pricing/flow logic, add the"
    echo "   matching TEST 0 case. To bypass in a true emergency: git commit --no-verify"
    exit 1
fi

# Dashboard view/action regression suite — offline (in-memory SQLite, mocked
# outbound), ~3s. Catches template-time 500s (e.g. the /conversations/ pager
# EmptyPage) and broken staff actions before they ship.
echo "🔒 Plumbot commit gate — running dashboard view/action suite…"
PYTHONIOENCODING=utf-8 "${PY_CMD[@]}" manage.py test bot -v 0
status=$?

if [ "$status" -ne 0 ]; then
    echo ""
    echo "❌ Commit blocked: the dashboard view/action suite failed."
    echo "   Run: python manage.py test bot -v 2   to see the failure."
    echo "   To bypass in a true emergency: git commit --no-verify"
    exit 1
fi

echo "✅ Commit gate passed."
exit 0
